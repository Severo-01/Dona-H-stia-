# Exemplo de variáveis de ambiente para o projeto
# Configure estas variáveis no ambiente de execução da aplicação e nunca as comite em repositórios públicos.
# O valor real deve ser obtido no painel do Supabase.

VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SEU_SUPABASE_ANON_KEY"

# Opcional: se você estiver usando autenticação customizada, configure no ambiente do deploy.
# Não armazene senhas de desenvolvimento ou chaves de administrador no frontend.
